# Traza OMIL — configuración del correo de avisos.
# Copie este archivo como .env (no se sube a git) y complete los valores. Reinicie el servidor al cambiarlo.

# Entorno: "produccion" envía a los destinatarios reales. Cualquier otro valor es "pruebas".
TRAZA_ENTORNO=pruebas
# URL pública del sistema (se usa en el enlace único que recibe el empleador)
TRAZA_URL=https://omil.municipalidadcasablanca.cl

# Modo de correo: simulado (no envía) | smtp | resend
CORREO_MODO=simulado
CORREO_REMITENTE="OMIL Casablanca <omil@municipalidadcasablanca.cl>"
CORREO_RESPONDER_A=omilpersonas@municipalidadcasablanca.cl

# Fuera de producción TODOS los avisos se desvían a este buzón (sin él, quedan retenidos y no sale nada).
CORREO_REDIRIGIR_A=pruebas.omil@municipalidadcasablanca.cl

# Intentos por aviso antes de quedar en "error" (reintentos a 1, 2, 5, 10, 20 y 30 min ≈ 1 hora, RN-04)
CORREO_MAX_INTENTOS=7

# --- Opción A: SMTP de la cuenta institucional o del relay municipal ---
# Google Workspace: smtp.gmail.com, 587, starttls, usuario = cuenta, clave = contraseña de aplicación
# Microsoft 365:    smtp.office365.com, 587, starttls, usuario = cuenta (SMTP AUTH habilitado para ella)
SMTP_HOST=smtp.office365.com
SMTP_PUERTO=587
SMTP_SEGURIDAD=starttls
SMTP_USUARIO=omil@municipalidadcasablanca.cl
SMTP_CLAVE=
# SMTP_HELO=omil.municipalidadcasablanca.cl

# --- Opción B: servicio de correo transaccional (Resend) con el dominio municipal verificado ---
# RESEND_API_KEY=

# --- Rebotes automáticos (webhook de Resend apuntando a /webhooks/correo) ---
# RESEND_WEBHOOK_SECRET=whsec_...

# --- Acceso ---
# TRAZA_LOGIN_DEMO=0          # quita el ingreso de demostración en pruebas (en producción nunca existe)

# --- Respaldos ---
# Frase larga para cifrar los respaldos (AES-256-GCM). Guárdela también FUERA del servidor: sin ella no se pueden restaurar.
TRAZA_RESPALDO_CLAVE=
# TRAZA_RESPALDOS=/ruta/a/respaldos
# TRAZA_RESPALDO_HORA=2
# TRAZA_RESPALDO_DIAS=30
